{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/oresoftware/ores-codex-plugin/schemas/marketplace.schema.json",
  "title": "Codex marketplace.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "interface", "plugins"],
  "properties": {
    "name": { "type": "string", "const": "oresoftware" },
    "interface": {
      "type": "object",
      "additionalProperties": false,
      "required": ["displayName"],
      "properties": {
        "displayName": { "type": "string", "minLength": 1 }
      }
    },
    "plugins": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "source", "policy", "category"],
        "properties": {
          "name": { "type": "string", "const": "ores-codex-plugin" },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source", "path"],
            "properties": {
              "source": { "type": "string", "const": "local" },
              "path": { "type": "string", "const": "./plugins/ores-codex-plugin" }
            }
          },
          "policy": {
            "type": "object",
            "additionalProperties": false,
            "required": ["installation", "authentication"],
            "properties": {
              "installation": { "type": "string", "enum": ["AVAILABLE", "INSTALLED_BY_DEFAULT", "NOT_AVAILABLE"] },
              "authentication": { "type": "string", "enum": ["ON_INSTALL", "ON_USE"] }
            }
          },
          "category": { "type": "string", "const": "Productivity" }
        }
      }
    }
  }
}
